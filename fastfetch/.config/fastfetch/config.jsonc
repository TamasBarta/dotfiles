{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/Pictures/Wallpaper",
    "width": 20,
    "padding": {
      "top": 2,
      "left": 4,
      "right": 4
    },
    "color": {
      "1": "#63d6c0",
      "2": "#63ccc3"
    }
  },
  "display": {
    "key": {
      "width": 20
    },
    "separator": ": ",
    "bar": {
      "border": {
        "left": "[ ",
        "right": " ]"
      }
    },
    "disableLinewrap": true,
    "color": {
      "keys": "#85d6c0",
      "title": "#b1ccc3"
    },
    "percent": {
      "color": {
        "green": "#a9cbe3",
        "yellow": "#85d6c0",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "break",
    "break",
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    "separator",
    "cpu",
    "gpu",
    "memory",
    "separator",
    "display",
    "de",
    "wm",
    "terminal",
    "terminalfont",
    "break",
    "colors",
    "break"
  ]
}
