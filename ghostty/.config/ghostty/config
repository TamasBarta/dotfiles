# =============================================================================
# Ghostty Configuration
# Full port of the wezterm config (wezterm/.config/wezterm/*)
# =============================================================================

# -----------------------------------------------------------------------------
# Font
# -----------------------------------------------------------------------------
# wezterm: font_with_fallback({ "JetbrainsMono NF", "JetbrainsMono Nerd Font" })
font-family = JetBrainsMono Nerd Font Mono
# wezterm: font_size = isLinux and 11.5 or 14 (ghostty has no per-OS conditionals; macOS value wins)
font-size = 14

# -----------------------------------------------------------------------------
# Layout
# -----------------------------------------------------------------------------
# wezterm: line_height = 1.10
adjust-cell-height = 10%

# wezterm: window_padding = { left = 0, right = 0, top = 0, bottom = 0 }
window-padding-x = 0
window-padding-y = 0

# -----------------------------------------------------------------------------
# Window / titlebar
# -----------------------------------------------------------------------------
# wezterm: enable_tab_bar = false (+ use_fancy_tab_bar = false)
# NOTE: this is GTK/Linux-only, macOS ignores it entirely.
window-show-tab-bar = never

# Tabs are native macOS tabs: yabai sees each tab as a separate window and
# may create phantom tiles (macOS API limitation — see notes from
# 2026-09-11; tabs deliberately kept, the layout re-assert workaround was
# rejected as too disruptive). super+t / super+1-9 / super+h,l drive them.
# wezterm (macOS): window_decorations = "INTEGRATED_BUTTONS|RESIZE"
# wezterm (macOS): integrated_title_button_style = "MacOsNative"
macos-titlebar-style = hdden

# wezterm (macOS): macos_window_background_blur = 90
background-blur = true

# wezterm (theme.lua): opacity 0.9 dark / 0.85 light; ghostty has no per-theme opacity
background-opacity = 0.875

# wezterm (linux/GNOME): integrated Gnome title buttons — on niri/hyprland the
# compositor handles decorations, nothing to port.
gtk-single-instance = true

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------
theme = matugen

# -----------------------------------------------------------------------------
# Behavior
# -----------------------------------------------------------------------------
# wezterm: hyperlink_rules = {} (no URL detection). Ghostty can't fully disable
# link detection; link-url=false prevents accidental single-click opens.
link-url = false

# wezterm: term = "wezterm" — ghostty exports TERM=xterm-ghostty, not configurable.
# wezterm: max_fps = 160 — ghostty renders vsync-driven, no equivalent.
# wezterm: niri clipboard focus hack — wezterm lua event, not portable.

# -----------------------------------------------------------------------------
# Keybindings
# -----------------------------------------------------------------------------

# --- Split navigation (wezterm smart-splits "move": ALT+h/j/k/l) ---
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# --- Split resize (wezterm used META = Cmd, but Cmd+h/l are taken by tab
# navigation in both configs, so alt+shift is used here instead) ---
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

# --- wezterm: SUPER+z TogglePaneZoomState (overrides ghostty's super+z=undo) ---
keybind = super+z=toggle_split_zoom

# --- wezterm: SUPER+h/l ActivateTabRelative(-1/+1) ---
keybind = super+h=previous_tab
keybind = super+l=next_tab

# --- Scroll (Shift+PageUp/Down) ---
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
# --- wezterm: SHIFT+PageUp/PageDown ScrollByPage(-0.5/+0.5) ---
# (overrides ghostty's default shift+page_* selection adjustment)
keybind = shift+page_up=scroll_page_fractional:-0.5
keybind = shift+page_down=scroll_page_fractional:0.5

# --- wezterm: SUPER+p ActivateCommandPalette (ghostty's default super+shift+p
# keeps working too) ---
keybind = super+p=toggle_command_palette

# --- No ghostty equivalent (not ported) ---
# wezterm QuickSelect: SUPER+ALT+p / SUPER+SHIFT+p (mrjones2014's ghostty
# feature request: https://github.com/ghostty-org/ghostty/discussions/4043)
# wezterm SUPER+e vim-scrollback: closest are super+f search +
#   super+arrow_up/down jump_to_prompt
# wezterm CTRL+SHIFT+W workspace launcher: no workspaces in ghostty
# wezterm DisableDefaultAssignment keys (CTRL+SHIFT+u, ALT+Enter, CTRL+SHIFT+p):
#   unbound by default in ghostty, nothing to disable
